<?xml version="1.0" encoding="UTF-8"?>
<!--
    DBT department: a SEPARATE Spring Boot application with its own build (same pattern as simulators/).
    Not a module of the root pom; it reaches Samanvay only over HTTP. Built together with the kit (departments/pom.xml).
    Build: ./mvnw -f departments/pom.xml -pl dbt -am verify
    Run:   ./mvnw -f departments/pom.xml -pl dbt -am spring-boot:run   (port 8092)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.samanvay</groupId>
    <artifactId>samanvay-dept-dbt</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>samanvay-dept-dbt</name>
    <description>DBT department: a standalone stand-in department service (own data, manifest and security). Fake data only.</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- The portal backend, the Samanvay client and the consent signer shared by every department. -->
        <dependency>
            <groupId>com.samanvay</groupId>
            <artifactId>samanvay-dept-kit</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>10.9.1</version>
        </dependency>

        <!-- The department's own Postgres (when dbt.db.url is set); without it the built-in seed is used. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>2.0.5</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>samanvay-dept-dbt</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- Postgres rejects some JVM zone names (e.g. Asia/Calcutta); same fix as the root project. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Duser.timezone=UTC</argLine>
                    <!-- The dev profile (application-dev.yml) switches demo mode on, as a local run does. Tests of the refusal itself switch it off again. -->
                    <systemPropertyVariables>
                        <spring.profiles.active>dev</spring.profiles.active>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
