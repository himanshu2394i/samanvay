<?xml version="1.0" encoding="UTF-8"?>
<!--
    The four department services and the kit they share. Not a module of the root pom: the departments reach Samanvay only over HTTP.
    Build everything:       ./mvnw -f departments/pom.xml verify
    Build one department:   ./mvnw -f departments/pom.xml -pl education -am verify
    Run one:                ./mvnw -f departments/pom.xml -pl education -am spring-boot:run   (the kit builds first)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.samanvay</groupId>
    <artifactId>samanvay-departments</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>samanvay-departments</name>

    <modules>
        <module>kit</module>
        <module>revenue</module>
        <module>dbt</module>
        <module>education</module>
        <module>agriculture</module>
    </modules>
</project>
