# All optional. The SPA reads the citizen realm's issuer + browser client from the
# API's public GET /ui/auth-config, so a stock `docker compose up` + app needs none of these.

# Override where the dev server proxies /api and /ui (default http://localhost:8080)
# SAMANVAY_API_URL=http://localhost:8080

# Bypass /ui/auth-config and configure OIDC explicitly (both must be set):
# VITE_OIDC_AUTHORITY=http://localhost:8180/realms/samanvay-citizen
# VITE_OIDC_CLIENT_ID=samanvay-citizen-ui
