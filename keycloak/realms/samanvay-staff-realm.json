  "authenticationFlows": [
    {
      "alias": "staff browser",
      "description": "Passkey, or password + TOTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "staff browser forms"
        }
      ]
    },
    {
      "alias": "staff browser forms",
      "description": "username/password (or passkey), then TOTP unless passkey",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-username-password-form"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "staff second factor"
        }
      ]
    },
    {
      "alias": "staff second factor",
      "description": "TOTP for every non-passkey sign-in",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-credential",
          "authenticatorConfig": "not signed in with a passkey"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form"
        }
      ]
    },
    {
      "alias": "staff direct grant",
      "description": "Direct grant also demands TOTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "direct-grant-validate-username"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "direct-grant-validate-password"
        },
        {
          "requirement": "REQUIRED",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "direct-grant-validate-otp"
        }
      ]
    },
    {
      "alias": "staff reset credentials",
      "description": "Reset password only after TOTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "reset-credentials-choose-user"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "reset-credential-email"
        },
        {
          "requirement": "REQUIRED",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form"
        },
        {
          "requirement": "REQUIRED",
          "priority": 40,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "reset-password"
        }
      ]
    }
