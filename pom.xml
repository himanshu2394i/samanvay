<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.samanvay</groupId>
    <artifactId>samanvay-core</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>samanvay-core</name>
    <description>Samanvay - Government Digital Platform Interoperability Platform (SIH26129)</description>

    <properties>
        <java.version>21</java.version>
        <!-- must match the Keycloak image in docker-compose.yml / KeycloakTestSupport -->
        <keycloak.version>26.4.7</keycloak.version>
        <!-- Not managed by the Spring Boot BOM, so pinned here. Latest stable 2.x. -->
        <sshd.version>2.18.0</sshd.version>
        <!-- Flowable 8.x is the Spring 7 / Boot 4 generation (Jackson 3, jakarta). Not managed by the Boot BOM. -->
        <flowable.version>8.0.0</flowable.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>2.1.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>2.0.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- REST endpoints -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Database access (JPA/Hibernate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Postgres driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Schema migrations. Boot 4 moved Flyway auto-config into this starter;
             flyway-core alone does not run V1. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Resilience4j: circuit breaker / retry / bulkhead for connector's
             per-data-source resilience (see docs/architecture/lld/06-connector.md).
             The "-spring-boot4" artifact, not "-spring-boot3" - verified on
             Maven Central, released specifically for Boot 4 / Spring 7. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>2.4.0</version>
        </dependency>

        <!-- Real SFTP transport for the connector's SFTP_CSV adapter (Apache MINA sshd client).
             sshd-sftp brings sshd-core transitively; the same jars provide the embedded SshServer
             used by SftpCsvRealTransportTest, so there is no separate test-scope declaration
             (declaring sshd-core test-scope would narrow it out of the main classpath). -->
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-sftp</artifactId>
            <version>${sshd.version}</version>
        </dependency>

        <!--
            Spring Modulith: module boundaries + event publication registry.
            The "-jdbc" starter (not "-jpa") is deliberate: our own entities
            still use JPA/Hibernate normally, but Modulith's own event log
            bypasses the JPA provider entirely for its own table, which
            avoids a real Hibernate-entity-vs-documented-schema mismatch
            that trips up ddl-auto=validate on the JPA variant.
        -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jdbc</artifactId>
        </dependency>

        <!-- Edge authN/authZ: OAuth2 resource server validating Keycloak JWTs
             (staff + citizen realms). See com.samanvay.shared.security. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Micrometer registry for the refused-call counter (samanvay.api.unauthenticated);
             only the health endpoint is exposed over HTTP (Boot default). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Notification EMAIL channel (JavaMailSender). Boot only creates the sender when spring.mail.host is
             set, so the default context (no SMTP configured) is unaffected; EmailChannel degrades to a failed
             DeliveryOutcome without it. Dev SMTP (Mailpit) lives in application-dev.yml. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Flowable BPMN engine behind the WorkflowEngine port (opt-in, samanvay.workflow.engine=flowable).
             Wired programmatically in FlowableEngineConfiguration; the flowable-spring-boot-starter is
             deliberately NOT used because its autoconfiguration would boot the engine (and create ACT_*
             tables) in the default in-process mode. -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-engine</artifactId>
            <version>${flowable.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring</artifactId>
            <version>${flowable.version}</version>
        </dependency>

        <!-- Testing -->
        <!-- In-JVM SMTP server for EmailChannel tests (no Docker). -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail</artifactId>
            <version>2.1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Realm-export check only (KeycloakRealmExportIT); ITs never need a live IdP. -->
        <dependency>
            <groupId>com.github.dasniko</groupId>
            <artifactId>testcontainers-keycloak</artifactId>
            <version>4.3.1</version>
            <scope>test</scope>
            <exclusions>
                <!-- The admin client drags Jackson 2 + RESTEasy onto the test
                     classpath; the realm check talks to the admin REST API
                     with the JDK HttpClient instead. -->
                <exclusion>
                    <groupId>org.keycloak</groupId>
                    <artifactId>keycloak-admin-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Compile-only API for the Keycloak email-OTP provider in keycloak/email-otp
             (built into target/keycloak-providers, never part of the app). Test scope
             keeps it out of the Spring Boot jar; no transitive dependencies. -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi</artifactId>
            <version>${keycloak.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi-private</artifactId>
            <version>${keycloak.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-core</artifactId>
            <version>${keycloak.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-common</artifactId>
            <version>${keycloak.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>3.1.0</version>
            <scope>test</scope>
        </dependency>
        <!-- jboss-logging (needed to compile the Keycloak provider) is NOT declared
             here: it is a runtime dependency of Hibernate, and a test-scoped
             declaration would drop it from the packaged app (PackagedJarIT). -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- the committed dev realm exports, so KeycloakRealmExportIT imports exactly what docker compose does -->
            <testResource>
                <directory>keycloak/realms</directory>
                <targetPath>keycloak-realms</targetPath>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- keycloak/email-otp: the citizen realm's email one-time-code
                 authenticator (Keycloak 26.4 ships none). Compiled against the
                 test-scoped Keycloak SPI into its own directory and packaged as
                 target/keycloak-providers/samanvay-keycloak-email-otp.jar, which
                 docker compose mounts and the Keycloak ITs load. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>keycloak-email-otp</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/keycloak/email-otp/src/main/java</compileSourceRoot>
                            </compileSourceRoots>
                            <outputDirectory>${project.build.directory}/keycloak-email-otp/classes</outputDirectory>
                            <useIncrementalCompilation>false</useIncrementalCompilation>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>keycloak-email-otp-resources</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/keycloak-email-otp/classes</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/keycloak/email-otp/src/main/resources</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>keycloak-email-otp-jar</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/keycloak-providers"/>
                                <jar destfile="${project.build.directory}/keycloak-providers/samanvay-keycloak-email-otp.jar"
                                     basedir="${project.build.directory}/keycloak-email-otp/classes"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- See com.samanvay.SamanvayApplication's static block: on
                         India-locale machines the JVM's default zone is the
                         legacy alias "Asia/Calcutta", which Postgres's tzdata
                         rejects. That fix only fires when main() is actually
                         launched - @SpringBootTest boots the app via ASM-based
                         annotation scanning, which never triggers
                         SamanvayApplication's class initialization at all, so
                         every *IT test needs this set at the forked JVM's
                         startup instead, before any class loads. -->
                    <argLine>-Duser.timezone=UTC</argLine>
                    <!-- TEST-ONLY fake credentials for the in-process RealDepartments
                         fixtures (see com.samanvay.shared.test.RealDepartments). Base64 of
                         fixtureuser:fixturepass and pcb_ro:pcb_ro_demo; not real secrets. -->
                    <environmentVariables>
                        <SAMANVAY_SECRET_SOURCE_DEPT_PROPERTY_SFTP_CREDENTIAL>Zml4dHVyZXVzZXI6Zml4dHVyZXBhc3M=</SAMANVAY_SECRET_SOURCE_DEPT_PROPERTY_SFTP_CREDENTIAL>
                        <SAMANVAY_SECRET_SOURCE_DEPT_POLLUTION_JDBC_CREDENTIAL>cGNiX3JvOnBjYl9yb19kZW1v</SAMANVAY_SECRET_SOURCE_DEPT_POLLUTION_JDBC_CREDENTIAL>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Same reasoning as maven-failsafe-plugin above, for any
                         *Test that also opens a real Postgres connection. -->
                    <argLine>-Duser.timezone=UTC</argLine>
                    <environmentVariables>
                        <SAMANVAY_SECRET_SOURCE_DEPT_PROPERTY_SFTP_CREDENTIAL>Zml4dHVyZXVzZXI6Zml4dHVyZXBhc3M=</SAMANVAY_SECRET_SOURCE_DEPT_PROPERTY_SFTP_CREDENTIAL>
                        <SAMANVAY_SECRET_SOURCE_DEPT_POLLUTION_JDBC_CREDENTIAL>cGNiX3JvOnBjYl9yb19kZW1v</SAMANVAY_SECRET_SOURCE_DEPT_POLLUTION_JDBC_CREDENTIAL>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
