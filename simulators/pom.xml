<?xml version="1.0" encoding="UTF-8"?>
<!--
    Department simulators: a SEPARATE Spring Boot application with its own build.

    Deliberately not a <module> of the root pom: the root project is the
    samanvay-core jar (packaging=jar), and nothing in it may depend on this
    artifact. Keeping the builds apart means the main app cannot even compile
    against simulator classes. CI builds and tests it through the main build:
    the contract IT builds simulators/Dockerfile, whose build stage runs
    `mvn verify` on this pom.

    Build: ./mvnw -f simulators/pom.xml verify   (from the repo root)
    Run:   ./mvnw -f simulators/pom.xml spring-boot:run   (port 8090)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.samanvay</groupId>
    <artifactId>samanvay-simulators</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>samanvay-simulators</name>
    <description>Spec-shaped department simulators for local/CI use. Never a live source.</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>samanvay-simulators</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
